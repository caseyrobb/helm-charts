# Helm ignore patterns for paperless-ngx chart
# This file is used to exclude files from the chart package

# Binaries for packages management
*/bin
*/obj

# Environment files
.env
.env.*
!.env.example

# IDE and editor files
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test files
*_test.go
*_test.py
*_test.js
*_test.ts
tests/
test/

# Documentation
*.md
!README.md
LICENSE
CONTRIBUTING.md
CHANGELOG.md

# Build artifacts
build/
dist/
*.egg-info/
*.pyc

# Git
.git
.gitignore

# Helm
*.tpl
_templates/
templates/_helpers.tpl

# Logs
*.log
logs/
